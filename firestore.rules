rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Única cuenta que puede editar (tiene que coincidir con EDITOR en app.js).
    function isEditor() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'julietaherreraf@gmail.com';
    }

    function acceso() {
      return get(/databases/$(database)/documents/config/acceso).data;
    }
    function hasAcceso() {
      return exists(/databases/$(database)/documents/config/acceso);
    }

    // Ven la agenda: mails en config/acceso.lectores (se manejan desde el botón "Acceso").
    function isReader() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hasAcceso()
        && request.auth.token.email.lower() in acceso().get('lectores', []);
    }

    // Ven los datos de autorización (DNI) y envían el mensaje: config/acceso.autorizan.
    function isAutoriza() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && hasAcceso()
        && request.auth.token.email.lower() in acceso().get('autorizan', []);
    }

    function validReserva(d) {
      return d.keys().hasOnly(['nombre','desde','hasta','adultos','ninos','origen','notas'])
        && d.nombre is string && d.nombre.size() > 0 && d.nombre.size() <= 100
        && d.desde is string && d.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hasta is string && d.hasta.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.hasta > d.desde
        && d.origen in ['Booking','Directa','Airbnb']
        && (d.adultos == null || (d.adultos is int && d.adultos >= 0 && d.adultos <= 30))
        && (d.ninos == null || (d.ninos is int && d.ninos >= 0 && d.ninos <= 30))
        && d.notas is string && d.notas.size() <= 500;
    }

    match /reservas/{id} {
      allow read: if isEditor() || isReader();
      allow create, update: if isEditor() && validReserva(request.resource.data);
      allow delete: if isEditor();
    }

    // Datos autorización: un documento por reserva, mismo id que la reserva.
    match /fichas/{id} {
      allow read: if isEditor() || isAutoriza();
      allow create, update: if isEditor()
        && request.resource.data.keys().hasOnly(['personas','enmascarado'])
        && request.resource.data.personas is list
        && request.resource.data.personas.size() <= 30
        && request.resource.data.enmascarado is bool;
      allow delete: if isEditor();
    }

    match /config/acceso {
      allow read: if isEditor();
      allow write: if isEditor()
        && request.resource.data.keys().hasOnly(['lectores','autorizan'])
        && request.resource.data.lectores is list
        && request.resource.data.lectores.size() <= 20
        && request.resource.data.get('autorizan', []) is list
        && request.resource.data.get('autorizan', []).size() <= 5;
    }

    match /config/firma {
      allow read: if isEditor() || isAutoriza();
      allow write: if isEditor()
        && request.resource.data.keys().hasOnly(['nombre','dni'])
        && request.resource.data.nombre is string && request.resource.data.nombre.size() <= 100
        && request.resource.data.dni is string && request.resource.data.dni.matches('^[0-9]{7,8}$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
